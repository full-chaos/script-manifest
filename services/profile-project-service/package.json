{
  "name": "@script-manifest/profile-project-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --watch-path=../../packages/contracts/dist --watch-path=../../packages/db/dist --watch-path=../../packages/service-utils/dist --watch-path=../../packages/search/dist --import @script-manifest/service-utils/instrument src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import @script-manifest/service-utils/instrument dist/index.js",
    "test": "node --experimental-test-module-mocks --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "@script-manifest/contracts": "workspace:*",
    "@script-manifest/db": "workspace:*",
    "@script-manifest/search": "workspace:*",
    "@script-manifest/service-utils": "workspace:*",
    "fastify": "^5.8.5",
    "undici": "^8.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
